# Origen exacto de esta instalación (sin barra final). En Vercel use su dominio HTTPS.
APP_BASE_URL=http://localhost:3000
# Dominio del tenant Auth0, por ejemplo dev-xxxx.us.auth0.com
AUTH0_DOMAIN=
# Datos de una aplicación Auth0 de tipo Regular Web Application
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Genere una clave aleatoria distinta por entorno: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
