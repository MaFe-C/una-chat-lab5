{
  "dependencies": {
    "express": "*",
    "socket.io": "*"
  },
  "scripts": {
    "start": "node chat-server.js",
    "test": "mocha",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium",
    "test:all": "npm test && npm run test:integration && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  }
}
